<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "i915-sriov">
  <!ENTITY author    "airlychee">
  <!ENTITY version   "2026.10.28.1">
  <!ENTITY launch    "Settings/intel-&name;">
  <!ENTITY gitURL    "https://github.com/&author;/unraid-&name;/raw/master">
  <!ENTITY pluginURL "&gitURL;/&name;.plg">
  <!ENTITY md5       "73f5d24577d02fe98c43913fdef0daa2">
  <!ENTITY plugin    "/boot/config/plugins/&name;">
  <!ENTITY emhttp    "/usr/local/emhttp/plugins/intel-&name;">
  <!ENTITY packages  "/boot/config/plugins/&name;/packages">
]>

<PLUGIN name="intel-&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        min="7.3.4"
        support="https://forums.unraid.net/topic/154464-plugin-intel-igpu-sr-iov-support-page/">


<CHANGES>
### 2026.10.28.1
- Unraid 7.3.4 native WebUI controls VF count and VFIO bindings.
- Install only airlychee kernel-matched i915 and intel_sriov_compat modules.
- Reapply native persisted SR-IOV VF and VFIO settings after boot.
- No live force-unload of already running stock i915.


### 2026.10.28
- Fork-specific UI package and checksum.
- Resolve and validate the exact kernel package before changing host settings.
- Fix cached package validation and exact install filename.


### 2024.02.19
- Forked repository from ich777.

### 2023.11.22
- Only apply patch for libvirt.php on Unraid versions lower than 6.13 - thanks SimonF for implementing that

### 2023.11.21
- Updated plugin from community developer zhtengw to make sure community is able to use SRIOV
- Use GitHub Releases for plugin package downloads
- Be a bit more verbose on plugin installation
- Add Plugin Update Helper
- A little bit of code cleanup
- Please use the original support thread for questions related to the plugin

### 2023.04.06
- Make change VFs number work;
- Add option for saving to config file only;
- Add support for unRAID 6.10.x

### 2023.04.01
- Make tools.sh work with multiple Intel Graphic Cards;
- Restore libvirt.php when module download failed;
- Make slot of PCI address to 0 when machine type is q35

### 2023.03.30
- Add plugin page in Settings;
- Fix HW transcode not work for PF on linux-5.19

### 2023.03.28
- Change PCI address of VF to 0000:06:10.0

### 2023.03.21
- Initial unRAID V6.11 release.
</CHANGES>


<FILE Run="/bin/bash">
<INLINE>
rm -f $(ls &plugin;/unraid-&name;*.txz 2>/dev/null|grep -v '&version;')
</INLINE>
</FILE>

<FILE Name="&emhttp;/README.md">
<INLINE>
**Intel Graphics SR-IOV**

This package contains a modified i915 driver with SR-IOV support for Intel 12Gen+ CPUs.  
ATTENTION: This package is highly experimental and you should only install it if you know what you are doing!  
You can get more details here: https://github.com/strongtz/i915-sriov-dkms
</INLINE>
</FILE>

<FILE Name="&plugin;/unraid-&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/unraid-&name;-&version;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
# Unraid 7.3.4+ native SR-IOV integration. Only the driver comes from the fork.
set -euo pipefail
PLUGIN_DIR="&amp;plugin;"
CACHE_DIR="&amp;packages;"
KERNEL_V="$(uname -r)"
PF="0000:00:02.0"
GPU_ID="8086:a7a0"
RELEASE="https://github.com/airlychee/unraid-i915-sriov/releases/download/${KERNEL_V}"
RELEASE_API="https://api.github.com/repos/airlychee/unraid-i915-sriov/releases/tags/${KERNEL_V}"
CACHE="${CACHE_DIR}/${KERNEL_V%%-*}"
mkdir -p "$CACHE"

log() { printf '[airlychee i915-sriov] %s\n' "$*"; }
fail() { log "ERROR: $*" &gt;&amp;2; exit 1; }

[[ "$KERNEL_V" == *-Unraid ]] || fail "Unsupported kernel: $KERNEL_V"
[[ -d "/sys/bus/pci/devices/${PF}" ]] || fail 'Expected PF 00:02.0 is missing'
[[ "$(cat "/sys/bus/pci/devices/${PF}/vendor")" == '0x8086' ]] || fail 'Unexpected PF vendor'
[[ "$(cat "/sys/bus/pci/devices/${PF}/device")" == '0xa7a0' ]] || fail 'Unexpected PF device ID'

# Select only a TXZ containing the exact Unraid kernel release.
PACKAGE=''
if api="$(wget -q -T 15 -t 2 -O - "$RELEASE_API")"; then
  PACKAGE="$(printf '%s' "$api" | jq -r '.assets[]?.name' \
    | grep -E '^i915-sriov-.*\.txz$' \
    | grep -F -- "-${KERNEL_V}-" | sort -V | tail -1 || true)"
fi
if [[ -z "$PACKAGE" ]]; then
  log 'Release API unavailable or no published matching asset; checking verified local cache'
  while IFS= read -r item; do
    base="${item##*/}"
    if [[ "$base" == i915-sriov-*.txz &amp;&amp; "$base" == *"-${KERNEL_V}-"* ]]; then
      PACKAGE="$base"
    fi
  done &lt; &lt;(find "$CACHE" -maxdepth 1 -type f -name '*.txz' | sort -V)
fi
[[ -n "$PACKAGE" ]] || fail "No released or cached TXZ for $KERNEL_V (draft releases cannot be downloaded)"
TARGET="$CACHE/$PACKAGE"
verify() {
  [[ -s "$TARGET" &amp;&amp; -s "$TARGET.md5" &amp;&amp; -s "$TARGET.sha256" ]] || return 1
  (cd "$CACHE" &amp;&amp; md5sum -c --status "$PACKAGE.md5" &amp;&amp; sha256sum -c --status "$PACKAGE.sha256") || return 1
  tar -tJf "$TARGET" | grep -Fxq "./lib/modules/$KERNEL_V/kernel/drivers/gpu/drm/i915/i915.ko.xz" || return 1
  tar -tJf "$TARGET" | grep -Fxq "./lib/modules/$KERNEL_V/updates/intel_sriov_compat.ko.xz" || return 1
}
if verify; then
  log "Verified cached package: $PACKAGE"
else
  [[ -n "${api:-}" ]] || fail 'Cached package unavailable and Release API not reachable'
  tmp="${TARGET}.partial.$$"
  trap 'rm -f "${tmp}" "${tmp}.md5" "${tmp}.sha256"' EXIT
  wget -q -T 30 -t 3 -O "$tmp" "$RELEASE/$PACKAGE" || fail 'Could not download TXZ'
  wget -q -T 20 -t 3 -O "${tmp}.md5" "$RELEASE/$PACKAGE.md5" || fail 'Could not download MD5'
  wget -q -T 20 -t 3 -O "${tmp}.sha256" "$RELEASE/$PACKAGE.sha256" || fail 'Could not download SHA256'
  mv -f "$tmp" "$TARGET"
  mv -f "${tmp}.md5" "$TARGET.md5"
  mv -f "${tmp}.sha256" "$TARGET.sha256"
  verify || fail 'Checksum or module layout mismatch'
  log "Verified downloaded package: $PACKAGE"
fi

# Install the matched modules into Unraid's RAM-backed kernel filesystem.
# Never forcibly unload a running i915; a reboot is needed if stock is loaded.
if [[ ! -f "/var/log/packages/${PACKAGE%.txz}" ]]; then
  /sbin/installpkg "$TARGET" || fail "Could not install $PACKAGE"
fi
depmod -a || fail 'depmod failed'
modinfo -F depends i915 | tr ',' '\n' | grep -Fxq intel_sriov_compat || fail 'Driver on disk is not our SR-IOV build'

# Match the original plugin's boot-time i915 loading policy.
mkdir -p /boot/config/modprobe.d
if ! grep -Eq '^[[:space:]]*blacklist[[:space:]]+i915([[:space:]]|$)' /boot/config/modprobe.d/i915.conf 2&gt;/dev/null; then
  printf 'blacklist i915\n' &gt;&gt; /boot/config/modprobe.d/i915.conf
fi
if ! lsmod | grep -q '^i915[[:space:]]'; then
  modprobe i915 enable_guc=3 max_vfs=7 || fail 'Could not load i915 SR-IOV'
fi
RUNNING_VERSION="$(cat /sys/module/i915/version 2&gt;/dev/null || true)"
if [[ "$RUNNING_VERSION" != '2026.03.05.7-sriov' ]]; then
  log "Running driver ($RUNNING_VERSION) is not the SR-IOV build; reboot required."
  exit 0
fi
log "Running i915 driver: $RUNNING_VERSION"

# Unraid 7.3 native System Devices owns VF count and VFIO settings.
# It saves them to /boot/config/sriov.cfg and sriovvfs.cfg.
# Avoid the old plugin's independent vfnumber= setting.
SRI_CFG='/boot/config/sriov.cfg'
if [[ -f "$SRI_CFG" ]]; then
  sri_line="$(grep -m1 '^VFS=' "$SRI_CFG" || true)"
  sri_line="${sri_line#VFS=}"
  sri_line="${sri_line//\"/}"
  for entry in $sri_line; do
    IFS='|' read -r bdf vid count &lt;&lt;&lt; "$entry"
    if [[ "$bdf" == "$PF" &amp;&amp; "${vid,,}" == "$GPU_ID" ]]; then
      [[ "$count" =~ ^[0-7]$ ]] || fail "Invalid native VF count: $count"
      current="$(cat "/sys/bus/pci/devices/$PF/sriov_numvfs")"
      if [[ "$current" == "$count" ]]; then
        log "VF count already correct: $count"
      elif [[ "$current" == '0' ]]; then
        [[ "$count" == '0' ]] || printf '%s\n' "$count" &gt; "/sys/bus/pci/devices/$PF/sriov_numvfs"
        log "Applied native VF count: $count"
      else
        log "VF count $current differs from configured $count; change with all VMs shut down (or reboot)."
      fi
    fi
  done
fi

# Apply only native VFIO selections for VFs owned by this Intel PF.
VF_CFG='/boot/config/sriovvfs.cfg'
if [[ -f "$VF_CFG" ]]; then
  modprobe vfio-pci || fail 'vfio-pci unavailable'
  vf_line="$(grep -m1 '^VFSETTINGS=' "$VF_CFG" || true)"
  vf_line="${vf_line#VFSETTINGS=}"
  vf_line="${vf_line//\"/}"
  for entry in $vf_line; do
    IFS='|' read -r bdf vid class vfio mac &lt;&lt;&lt; "$entry"
    [[ "$vfio" == '1' &amp;&amp; "${vid,,}" == "$GPU_ID" &amp;&amp; "$class" == '0x03' ]] || continue
    dev="/sys/bus/pci/devices/$bdf"
    [[ -d "$dev" &amp;&amp; -L "$dev/physfn" ]] || continue
    [[ "$(basename "$(readlink -f "$dev/physfn")")" == "$PF" ]] || continue
    current_driver='none'
    if [[ -L "$dev/driver" ]]; then
      current_driver="$(basename "$(readlink -f "$dev/driver")")"
    fi
    [[ "$current_driver" == 'vfio-pci' ]] &amp;&amp; continue
    [[ "$current_driver" == 'none' || "$current_driver" == 'i915' ]] || fail "Unexpected VF driver for $bdf: $current_driver"
    printf 'vfio-pci\n' &gt; "$dev/driver_override"
    if [[ "$current_driver" == 'i915' ]]; then
      printf '%s\n' "$bdf" &gt; "$dev/driver/unbind"
    fi
    printf '%s\n' "$bdf" &gt; /sys/bus/pci/drivers/vfio-pci/bind || fail "VFIO bind failed: $bdf"
    log "Bound native-selected VF $bdf to vfio-pci"
  done
fi
log 'Native Unraid System Devices manages future VF changes.'

</INLINE>
</FILE>

<!-- The 'remove' script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo
echo "--------------------------------"
echo "---Uninstalling SR-IOV plugin---"
echo "--------------------------------"
removepkg unraid-&name;-&version;
rm -rf &plugin; &emhttp;

# Restore libvirt.php
if [ -f /usr/local/emhttp/plugins/dynamix.vm.manager/include/libvirt.php.orig ]; then
  cp /usr/local/emhttp/plugins/dynamix.vm.manager/include/libvirt.php.orig /usr/local/emhttp/plugins/dynamix.vm.manager/include/libvirt.php
  rm /usr/local/emhttp/plugins/dynamix.vm.manager/include/libvirt.php.orig
fi

# Remove blacklist
if [ "$(grep -v "blacklist" /boot/config/modprobe.d/i915.conf 2>/dev/null)" ]; then
  sed -i '/blacklist i915/d' /boot/config/modprobe.d/i915.conf 2>/dev/null
else
  rm -rf /boot/config/modprobe.d/i915.conf 2>/dev/null
fi

echo
echo "-----------------------------------------------------------"
echo "---SR-IOV plugin uninstalled, please reboot your server!---"
echo "-----------------------------------------------------------"

</INLINE>
</FILE>

</PLUGIN>

